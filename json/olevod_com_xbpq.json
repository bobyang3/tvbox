  "homeVodNode": "//div[@id='navlist']//a[contains(@class,'pc-case-line')]",
  "homeVodName": "//div[contains(@class,'case-content')]//h4/text()",
  "homeVodId": "/@href",
  "homeVodIdR": "/details-\\d+-(\\d+).html",
  "homeVodImg": "//div[contains(@class,'case-img')]//img[contains(@class,'el-image__inner')]//@src",
  "homeVodMark": "//span[contains(@class,'right-score')]/text()",

  "分类url": "https://www.olevod.com/nav/电影/全部地区/全部年份/全部类型/全部/全部/最新.html[$--https://olevod.com/index.php/vod/show{area}{class}{by}/id/{cateId}/page/{catePg}{year}.html]",
  "分类": "电影$1#连续剧$2#综艺$3#动漫$4#蓝光影院$6",
  
  "cateVodNode": "//ul[contains(@class,'vodlist vodlist_wi')]//li//a[contains(@class,'vodlist_thumb')]",
  "cateVodName": "/@title",
  "cateVodId": "/@href",
  "cateVodIdR": "/index.php/vod/detail/id/(\\w+).html",
  "cateVodImg": "/@data-original",
  "cateVodImgR": "\\S+(http\\S+)",
  "cateVodMark": "/span[@class='pic_text text_right']/em/text()",

  "详情url": "https://olevod.com/index.php/vod/detail/id/{vid}.html",
  "dtNode": "//div[contains(@class,'hot_banner')]",
  "导演": "//div[contains(@class,'content_detail')]//span[contains(text(), '导演')]/following-sibling::*/text()",
  "主演": "//div[contains(@class,'content_detail')]//span[contains(text(), '主演')]/following-sibling::*/text()",
  "影片状态": "//div[contains(@class,'content_detail')]//span[contains(text(), '状态')]/following-sibling::*/text()",
  "影片类型": "//div[contains(@class,'content_detail')]//span[contains(@class,'text_muted hidden_xs') and contains(text(), '类型')]/following-sibling::*/text()",
  "简介": "//div[contains(@class,'content_detail')]//span[contains(@class,'left text_muted') and contains(text(), '简介')]/parent::text()",

  "线路数组": "//div[contains(@class,'play_source_tab')]/a",
  "线路标题": "/@alt",
  "播放数组": "//div[contains(@class,'playlist_full')]/ul[contains(@class,'content_playlist clearfix')]",
  "播放列表": "//li/a",
  "播放标题": "/text()",
  "播放url": "/@href",
  "播放urlR": "/index.php/vod/play/id/(\\S+).html",
  "跳转播放url": "https://olevod.com/index.php/vod/play/id/{playUrl}.html",

  "搜索url": "https://olevod.com/index.php/ajax/suggest?mid=1&wd={wd}&limit=10",
